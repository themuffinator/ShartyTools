<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
    <RestorePackagesPath>$(ArtifactsPath)/packages</RestorePackagesPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Product>ShartyTools</Product>
    <Authors>ShartyTools contributors</Authors>
    <Copyright>Copyright © 2026 ShartyTools contributors</Copyright>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/themuffinator/ShartyTools</RepositoryUrl>
    <BaseVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</BaseVersion>
    <Version Condition="'$(ReleaseBuild)' == 'true'">$(BaseVersion)</Version>
    <Version Condition="'$(ReleaseBuild)' != 'true'">$(BaseVersion)-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Pin the bundled runtime independently of the local development SDK. -->
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
</Project>
